# --- Game server (server/index.ts) ---
# Port for the Express + Socket.IO game server.
PORT=4000
# Comma-separated list of allowed browser origins (CORS and WebSocket Origin check).
# Leave empty in development to allow any origin. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
# Round pacing. 90 ticks per round, so TICK_MS=2000 gives a 3-minute trading phase.
TICK_MS=2000
STARTING_MS=10000
RESOLVING_MS=4000

# --- Web app (Next.js) ---
# Public URL of the game server. Defaults to http://<current host>:4000 when unset.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# --- Database (optional) ---
# Without DATABASE_URL the game server runs purely in memory. With it, rounds, trades and results
# are saved to PostgreSQL (Supabase works as-is). Apply the schema with: pnpm db:migrate
#
# Supabase: Project → Connect → "Session pooler" connection string (IPv4, works for migrations too).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Optional: a direct/session URL used only by migrations, when DATABASE_URL is Supabase's
# transaction pooler (port 6543).
# DIRECT_URL=
#
# Recommended for Supabase: its CA certificate (Database settings → SSL Configuration → Download),
# so the server verifies the database's TLS certificate. Paste the PEM; "\n" escapes are fine.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- AI round summary (optional) ---
# A short Gemini-written recap on the results screen. Off when unset; the built-in debrief is always shown.
# Game server only (Render): never put this key on Vercel or behind a NEXT_PUBLIC_ prefix.
# GEMINI_API_KEY=
# Model for the recap (one short call per round). The default is a low-cost model.
# GEMINI_MODEL=gemini-3.5-flash-lite
