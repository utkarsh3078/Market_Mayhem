PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
TICK_MS=2000
STARTING_MS=10000
RESOLVING_MS=4000


NEXT_PUBLIC_SERVER_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DIRECT_URL=

DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500

# "random" = a new price seed every round; "scenario" = each scenario's fixed seed (demos, replays)
ROUND_SEED=random

# Live Newsroom anchor scripts: "none" = built-in templates, "gemini" = written by NEWSROOM_MODEL via GEMINI_API_KEY
NEWSROOM_SCRIPTS=none
NEWSROOM_MODEL=
