PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
TICK_MS=2000
STARTING_MS=10000
RESOLVING_MS=4000


NEXT_PUBLIC_SERVER_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DIRECT_URL=

DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

GEMINI_API_KEY=

# Optional. Leave unset to run the round summary on Gemma too; set a Gemini model to keep it on Gemini.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Gemma 4: AI Scenario mode and the round summary. Same key as above (Google AI Studio, no card needed).
# gemma-4-26b-a4b-it is faster (default); gemma-4-31b-it is larger. With Ollama use e.g. gemma4.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# OLLAMA_URL=http://localhost:11434   # self-hosted instead of the Gemini API (local demos)
# GEMMA_PROVIDER=off                  # gemini | ollama | off
# GEMMA_TIMEOUT_MS=90000
# AI_POOL_SIZE=2                      # AI scenarios kept ready in the background (0 = on demand only)
# AI_WARMUP=true                      # false = spend no quota until a host asks for an AI scenario
# AI_MIN_INTERVAL_MS=4000             # minimum gap between Gemma calls

GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500