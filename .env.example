# --- Game server (server/index.ts) ---
# Port for the Express + Socket.IO game server.
PORT=4000
# Comma-separated list of allowed browser origins (CORS and WebSocket Origin check).
# Leave empty in development to allow any origin. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
# Round pacing. 90 ticks per round, so TICK_MS=2000 gives a 3-minute trading phase.
TICK_MS=2000
STARTING_MS=10000
RESOLVING_MS=4000

# --- Web app (Next.js) ---
# Public URL of the game server. Defaults to http://<current host>:4000 when unset.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Not used by the demo (in-memory state). Reserved for the Prisma/PostgreSQL persistence layer.
# DATABASE_URL=postgresql://user:password@localhost:5432/market_mayhem
