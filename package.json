{
  "name": "market_mayhem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"next dev\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "demo:fast": "concurrently -k -n web,server -c cyan,magenta \"next dev\" \"TICK_MS=700 STARTING_MS=5000 tsx server/index.ts\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:server": "prisma generate && NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test server/test/*.test.ts",
    "typecheck": "next typegen && prisma generate && tsc --noEmit",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
